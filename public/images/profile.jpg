<svg width="500" height="500" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#60a5fa;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#a78bfa;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#22d3ee;stop-opacity:1" />
    </linearGradient>
  </defs>

  <rect width="500" height="500" fill="#1a2238"/>

  <!-- Circle background -->
  <circle cx="250" cy="250" r="200" fill="url(#grad)" opacity="0.2"/>

  <!-- User icon -->
  <circle cx="250" cy="200" r="60" fill="url(#grad)"/>
  <path d="M 150 400 Q 150 300 250 300 Q 350 300 350 400" fill="url(#grad)"/>

  <!-- Text -->
  <text x="250" y="450" font-family="Arial, sans-serif" font-size="24" fill="#e4e4e7" text-anchor="middle" font-weight="bold">ATHIRA DAS</text>
  <text x="250" y="480" font-family="Arial, sans-serif" font-size="14" fill="#a1a1aa" text-anchor="middle">Replace with your photo</text>
</svg>
